// lib/ingestion/adapters/startech.js
//
// Adapter for startech.com.bd — our pilot retailer (spec section 22).
// See MILESTONE_REPORT.md for the full provenance/confidence writeup
// (built against real pages fetched during development, no live network in
// this sandbox to run it — see test/fixtures/startech-*.html).
//
// Confidence: HIGH on product meta tags (verified live `og:`/`product:`
// tags), MEDIUM on spec-table DOM shape and listing-card class names
// (content verified live, exact DOM inferred as standard OpenCart).

import * as cheerio from "cheerio";
import { parseBDTPrice, cleanText } from "../normalize.mjs";
import { fetchHtml, metaContent, parseSpecTable, parsePricePair, findLabeledLine } from "./shared.js";

const BASE_URL = "https://www.startech.com.bd";

export const categorySources = [
  { category: "cpu", listingUrl: `${BASE_URL}/component/processor` },
  { category: "gpu", listingUrl: `${BASE_URL}/component/graphics-card` },
  { category: "ram", listingUrl: `${BASE_URL}/component/ram` },
  { category: "ssd", listingUrl: `${BASE_URL}/ssd` },
  { category: "mobo", listingUrl: `${BASE_URL}/component/motherboard` },
  { category: "psu", listingUrl: `${BASE_URL}/component/power-supply` },
  { category: "case", listingUrl: `${BASE_URL}/component/casing` },
  { category: "monitor", listingUrl: `${BASE_URL}/monitor` },
  { category: "laptop", listingUrl: `${BASE_URL}/laptop-notebook/laptop` },
  { category: "peripheral", listingUrl: `${BASE_URL}/accessories/mouse` },
];

/** Pure parsing of one listing page's HTML — no network I/O (testable). */
export function parseListingHtml(html) {
  const $ = cheerio.load(html);
  const links = [];
  const seen = new Set();

  $(".product-thumb, .product-layout").each((_, el) => {
    const anchor = $(el).find(".caption h4 a, .caption h3 a").first();
    const href = anchor.attr("href");
    if (!href || seen.has(href)) return;
    seen.add(href);
    const priceText = $(el).find(".price, .special").first().text();
    links.push({ url: href, previewName: cleanText(anchor.text()), previewPrice: parseBDTPrice(priceText) });
  });

  if (links.length === 0) {
    $("a[href]").each((_, el) => {
      const href = $(el).attr("href");
      const text = cleanText($(el).text());
      if (!href || !text || text.length < 8) return;
      if (!href.startsWith(BASE_URL)) return;
      if (seen.has(href)) return;
      if (/\/(component|category|accessories|information|account|tool)\//.test(href)) return;
      seen.add(href);
      links.push({ url: href, previewName: text, previewPrice: null });
    });
  }

  const bodyText = $("body").text();
  const pagesMatch = bodyText.match(/\((\d+)\s*Pages?\)/i);
  return { links, totalPages: (pagesMatch ? parseInt(pagesMatch[1], 10) : 1) || 1 };
}

export async function discoverCategoryPage(listingUrl, page = 1) {
  const url = page > 1 ? `${listingUrl}?page=${page}` : listingUrl;
  return parseListingHtml(await fetchHtml(url));
}

/** Pure parsing of one product detail page's HTML — no network I/O (testable). */
export function parseProductHtml(html, url) {
  const $ = cheerio.load(html);

  const name = metaContent($, "og:title") || cleanText($("h1").first().text());
  if (!name) return null;

  const brand = metaContent($, "product:brand");
  const sourceProductId = metaContent($, "product:retailer_item_id");
  const availabilityText = metaContent($, "product:availability");
  const mainImage = metaContent($, "og:image");
  const shortDescription = $('meta[name="description"]').attr("content") || null;
  const metaPrice = parseBDTPrice(metaContent($, "product:price:amount"));

  // Visible "cash discount" price is the real current price (can differ
  // from the og:price meta) — prefer it, meta price is the fallback.
  const priceBlockText = $(".price, #product .price, .product-info .price").first().text();
  let { price, previousPrice } = parsePricePair(priceBlockText);
  if (price == null) price = metaPrice;

  const model = findLabeledLine($, /^model:/i);

  const specContainer = $('#tab-specification, .tab-specification, [id*="specification" i]').first();
  const specs = parseSpecTable($, specContainer.length ? specContainer : $("body"));

  return {
    sourceProductId: sourceProductId || url,
    sourceUrl: url,
    name,
    brand,
    model,
    price,
    previousPrice,
    availabilityText,
    images: mainImage ? [mainImage] : [],
    shortDescription,
    specs,
  };
}

export async function parseProductPage(url) {
  return parseProductHtml(await fetchHtml(url), url);
}

export default {
  id: "startech",
  hostname: "startech.com.bd",
  categorySources,
  discoverCategoryPage,
  parseProductPage,
};
